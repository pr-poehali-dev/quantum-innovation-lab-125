      "method": "POST",
      "path": "/",
      "body": {
        "name": "Тест",
        "phone": "+70000000000",
        "city": "Москва",
        "email": "test@test.ru",
        "brief": {
          "usage": "Эспрессо в кофейню",
          "volume": 100
        }
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    }
  ]
